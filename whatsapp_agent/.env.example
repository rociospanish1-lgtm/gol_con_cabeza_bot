# --- WhatsApp Cloud API (developers.facebook.com > tu app > WhatsApp > Configuración de la API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Inventa una frase larga; la misma que pongas al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# Configuración de la app > Básica > Clave secreta de la app
WHATSAPP_APP_SECRET=

# --- Claude (console.anthropic.com > API Keys) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Control ---
# Tu móvil personal con prefijo 34, sin + ni espacios. Varios separados por comas.
ADMIN_NUMEROS=34600000000
# Clave larga y aleatoria para el panel web: https://TU-DOMINIO/panel?token=ESTA_CLAVE
ADMIN_TOKEN=
HORAS_PAUSA_MANUAL=12
MAX_RESPUESTAS_HORA=30
BOT_ACTIVO_INICIAL=true

# --- Negocio ---
NOMBRE_NEGOCIO=Agencia de Agentes IA
NOMBRE_RESPONSABLE=Rocío
ENLACE_AGENDA=
