# Copia este archivo como .env y rellénalo.

# Clave de la API de Claude (console.anthropic.com > API Keys). Obligatoria.
ANTHROPIC_API_KEY=

# Tu número de WhatsApp con prefijo, solo cifras. Si lo pones, el agente te da un
# código de 8 letras para vincularlo (más fácil en un servidor). Si lo dejas vacío, sale un QR.
WHATSAPP_NUMERO=34692431897

# Carpeta donde se guardan la sesión de WhatsApp y la memoria. En Railway: /data
DATA_DIR=data

# Horario que el agente ofrece para las demos de 15 minutos.
DISPONIBILIDAD_DEMOS=de lunes a viernes, de 10:00 a 13:00 y de 17:00 a 19:00

# "si" = arranca activado; "no" = arranca desactivado hasta que escribas #on.
# Después manda lo último que hayas escrito con #on / #off.
ACTIVO_AL_ARRANCAR=si

# Segundos que espera para juntar varios mensajes seguidos de la misma persona.
ESPERA_SEGUNDOS=6

# Horas que el agente se aparta de un chat cuando escribes tú en él (0 = nunca se aparta solo).
PAUSA_HUMANO_HORAS=12

# Mensajes anteriores que el agente relee en cada respuesta (además de la ficha).
HISTORIAL_MAX=40

# Modelo y nivel de esfuerzo. No hace falta tocarlos.
MODELO=claude-opus-5-5
ESFUERZO=low

# Página de estado para vincular desde el servidor: https://tu-app/?clave=CLAVE_ACCESO
# Pon una clave larga: quien entre ahí con el QR podría vincular tu WhatsApp.
PORT=8080
CLAVE_ACCESO=
